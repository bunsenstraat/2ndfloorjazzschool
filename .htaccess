# Apache hosting: custom 404 + redirect old URLs from previous versions of the site
ErrorDocument 404 /404.html
RedirectMatch 301 ^/home$ /
RedirectMatch 301 ^/(?i)saxofoonles-(beginners|gevorderden)$ /saxofoonles/
RedirectMatch 301 ^/prijzen$ /saxofoonles/
RedirectMatch 301 ^/jazzworkshops$ /jazzworkshops/
RedirectMatch 301 ^/(over|biografie|muziek|portfolio-details\.html)/?$ /docent/
RedirectMatch 301 ^/contact$ /contact/
